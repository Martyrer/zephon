<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Zephon third-party licenses</title>
<style>
  body { font: 14px/1.5 "Segoe UI", sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; }
  pre { white-space: pre-wrap; background: #f4f5f7; padding: 1em; border-radius: 6px; }
  li { margin: 0.2em 0; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Zephon includes the following open-source software.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licenses</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
